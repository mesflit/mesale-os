Window.SetBackgroundTopColor(0.03, 0.05, 0.12);
Window.SetBackgroundBottomColor(0.13, 0.20, 0.38);
w = Window.GetWidth(); h = Window.GetHeight();
logo = Sprite(Image("logo.png"));
li = Image("logo.png");
logo.SetX(w / 2 - li.GetWidth() / 2);
logo.SetY(h * 0.42 - li.GetHeight() / 2);
ni = Image("nokta.png");
for (i = 0; i < 3; i++) {
  n[i] = Sprite(ni);
  n[i].SetX(w / 2 - 7 + (i - 1) * 30);
  n[i].SetY(h * 0.66);
}
t = 0;
fun yenile() {
  t++;
  for (i = 0; i < 3; i++) n[i].SetOpacity(0.3 + 0.7 * Math.Abs(Math.Sin(t * 0.06 - i * 0.6)));
}
Plymouth.SetRefreshFunction(yenile);
soru = Sprite(); giris = Sprite();
fun parola(yazi, adet) {
  s = Image.Text(yazi, 0.9, 0.9, 1);
  soru.SetImage(s); soru.SetX(w / 2 - s.GetWidth() / 2); soru.SetY(h * 0.74); soru.SetOpacity(1);
  y = "";
  for (i = 0; i < adet; i++) y += "* ";
  g = Image.Text(y, 1, 0.54, 0.24);
  giris.SetImage(g); giris.SetX(w / 2 - g.GetWidth() / 2); giris.SetY(h * 0.79); giris.SetOpacity(1);
}
fun normal() { soru.SetOpacity(0); giris.SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(parola);
Plymouth.SetDisplayNormalFunction(normal);
msj = Sprite();
fun mesaj(m) { i = Image.Text(m, 0.8, 0.8, 0.95); msj.SetImage(i); msj.SetX(w / 2 - i.GetWidth() / 2); msj.SetY(h * 0.9); }
Plymouth.SetMessageFunction(mesaj);
