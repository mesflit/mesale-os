#!/bin/bash
# mesale-feature [list] | add <name>... | remove <name>...
set -euo pipefail
F=/usr/lib/mesale/features
load() { PKGS=""; FLATPAKS=""; NET=0; BIN=""; NAME=""; DESC=""; prepare() { :; }; after() { :; }; . "$F/$1"; }
installed() { load "$1"; [ -z "$BIN" ] || command -v "$BIN" >/dev/null || return 1
  local p; for p in $PKGS; do dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null | grep -qx installed || return 1; done
  for p in $FLATPAKS; do [ -e "/var/lib/flatpak/app/$p" ] || [ -e "/var/lib/flatpak/runtime/$p" ] || return 1; done; }
cmd=${1:-list}; [ $# -gt 0 ] && shift
if [ "$cmd" = list ]; then
  for f in "$F"/*; do n=${f##*/}; s=' '; installed "$n" && s='*'; load "$n"; printf ' %s %-14s %s\n' "$s" "$n" "$DESC"; done; exit 0
fi
[ $# -gt 0 ] || { sed -n 2p "$0"; exit 1; }
for n in "$@"; do [[ "$n" =~ ^[a-z0-9-]+$ && -f "$F/$n" ]] || { echo "Unknown feature: $n" >&2; exit 1; }; done
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$cmd" "$@"
export DEBIAN_FRONTEND=noninteractive
A=(apt-get -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confold)
for n in "$@"; do
  load "$n"
  case "$cmd" in
    add)
      prepare
      [ "$NET" = 0 ] || "${A[@]}" update
      [ -z "$PKGS" ] || "${A[@]}" install --no-install-recommends $PKGS
      if [ -n "$FLATPAKS" ]; then
        if [ -d /run/systemd/system ] && [ "${MESALE_INSTALL:-0}" = 0 ]; then flatpak install -y --noninteractive --system flathub $FLATPAKS
        else # in the installer: queue for first boot
          mkdir -p /var/lib/mesale; printf '%s\n' "$n" >>/var/lib/mesale/pending; systemctl enable mesale-pending.service 2>/dev/null || true; fi
      fi
      after ;;
    remove)
      [ -z "$FLATPAKS" ] || flatpak uninstall -y --noninteractive --system $FLATPAKS || true
      [ -z "$PKGS" ] || "${A[@]}" purge --autoremove $PKGS ;;
    *) sed -n 2p "$0"; exit 1 ;;
  esac
done
