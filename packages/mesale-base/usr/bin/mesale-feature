#!/bin/bash
# Usage: mesale-feature [list] | add <name>... | remove <name>...
# Features are shell fragments in /usr/lib/mesale/features (see AGENTS.md).
set -euo pipefail
FEATURES=/usr/lib/mesale/features
APT=(apt-get -y -o DPkg::Lock::Timeout=300 -o Dpkg::Options::=--force-confold)

usage() { sed -n 2p "$0"; exit 1; }

load() {
  NAME="" DESC="" PKGS="" FLATPAKS="" BIN="" NET=0 TESTING=0
  prepare() { :; }
  after() { :; }
  . "$FEATURES/$1"
}

is_installed() {
  local p
  load "$1"
  [ -z "$BIN" ] || command -v "$BIN" >/dev/null || return 1
  for p in $PKGS; do
    dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null | grep -qx installed || return 1
  done
  for p in $FLATPAKS; do
    [ -e "/var/lib/flatpak/app/$p" ] || [ -e "/var/lib/flatpak/$p" ] || return 1
  done
}

list() {
  local f n mark
  for f in "$FEATURES"/*; do
    n=${f##*/}
    mark=' '
    is_installed "$n" && mark='*'
    load "$n"
    printf ' %s %-14s %s\n' "$mark" "$n" "$DESC"
  done
}

# Flatpaks cannot be installed from the installer's chroot: queue them for first boot.
install_flatpaks() {
  if [ -d /run/systemd/system ] && [ "${MESALE_INSTALL:-0}" = 0 ]; then
    flatpak install -y --noninteractive --system flathub $FLATPAKS
  else
    mkdir -p /var/lib/mesale
    echo "$1" >>/var/lib/mesale/pending
    systemctl enable mesale-pending.service 2>/dev/null || true
  fi
}

add() {
  load "$1"
  prepare
  [ "$NET" = 0 ] || "${APT[@]}" update
  local from=()
  [ "$TESTING" = 0 ] || from=(-t forky) # GNOME apps come from the same release as GNOME
  if [ -n "$PKGS" ]; then
    # Offline features install from the image; once removed, they come from the network.
    "${APT[@]}" install --no-install-recommends "${from[@]}" $PKGS ||
      { [ "$NET" = 0 ] && "${APT[@]}" update && "${APT[@]}" install --no-install-recommends "${from[@]}" $PKGS; }
  fi
  [ -z "$FLATPAKS" ] || install_flatpaks "$1"
  after
}

remove() {
  load "$1"
  [ -z "$FLATPAKS" ] || flatpak uninstall -y --noninteractive --system $FLATPAKS || true
  [ -z "$PKGS" ] || "${APT[@]}" purge --autoremove $PKGS
}

command=${1:-list}
[ $# -gt 0 ] && shift
case "$command" in
  list) list; exit 0 ;;
  add | remove) [ $# -gt 0 ] || usage ;;
  *) usage ;;
esac
# Pasted commands can carry invisible characters (non-breaking spaces, CR): drop them.
names=()
for n in "$@"; do
  n=$(printf '%s' "$n" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C tr -cd 'a-z0-9-')
  [ -n "$n" ] || continue
  [ -f "$FEATURES/$n" ] || { echo "Unknown feature: $n (see: mesale-feature list)" >&2; exit 1; }
  names+=("$n")
done
[ ${#names[@]} -gt 0 ] || usage
set -- "${names[@]}"
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$command" "$@"
export DEBIAN_FRONTEND=noninteractive
for n in "$@"; do "$command" "$n"; done
