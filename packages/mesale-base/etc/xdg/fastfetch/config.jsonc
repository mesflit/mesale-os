// Mesale OS defaults. A ~/.config/fastfetch/config.jsonc of your own takes over.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/mesale/fastfetch.txt",
    "color": { "1": "38;2;255;194;122", "2": "38;2;255;138;61", "3": "38;2;226;80;42" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "38;2;255;138;61", "title": "38;2;156;200;242" },
    "separator": "  "
  },
  "modules": ["title", "separator", "os", "host", "kernel", "uptime", "packages", "shell", "de",
    "terminal", "cpu", "gpu", "memory", "disk", "battery", "break", "colors"]
}
