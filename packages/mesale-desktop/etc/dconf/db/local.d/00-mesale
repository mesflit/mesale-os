[org/gnome/shell]
enabled-extensions=['mesale-shell@mesale','dash-to-panel@jderose9.github.com','blur-my-shell@aunetx','tiling-assistant@leleat-on-github','ubuntu-appindicators@ubuntu.com']
favorite-apps=['org.gnome.Nautilus.desktop','firefox-esr.desktop','org.gnome.Software.desktop','org.gnome.Ptyxis.desktop','mesale-center.desktop','org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='999'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
accent-color='blue'
icon-theme='Adwaita'
cursor-theme='Bibata-Modern-Ice'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='Cascadia Code 11'
clock-show-date=true
show-battery-percentage=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mesale/day.jpg'
picture-uri-dark='file:///usr/share/backgrounds/mesale/night.jpg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/mesale/day.jpg'

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'
titlebar-font='Inter Semi-Bold 11'

[org/gnome/desktop/wm/keybindings]
switch-input-source=['<Shift><Super>space']
switch-input-source-backward=['<Control><Super>space']
close=['<Super>w','<Alt>F4']
switch-windows=['<Alt>Tab']
switch-applications=['<Super>Tab']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/terminal/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/nitro/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/terminal]
name='Terminal'
command='ptyxis --new-window'
binding='<Super>Return'

# The NitroSense key (KEY_PROG3 from the patched Linuwu-Sense)
[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/nitro]
name='Nitro'
command='mesale-center --nitro'
binding='XF86Launch3'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true

[org/gnome/mutter]
edge-tiling=false
dynamic-workspaces=true
center-new-windows=true

[org/gnome/desktop/privacy]
report-technical-problems=false
remember-recent-files=true

[org/gnome/shell/extensions/tiling-assistant]
window-gap=8
single-screen-gap=8
maximize-with-gap=false
enable-advanced-experimental-features=false

[org/gnome/Ptyxis]
use-system-font=true
interface-style='system'
# One profile with the Mesale palette (its file comes from /etc/skel)
default-profile-uuid='4d65f5a1-e000-4000-8000-6d6573616c65'
profile-uuids=['4d65f5a1-e000-4000-8000-6d6573616c65']

[org/gnome/Ptyxis/Profiles/4d65f5a1-e000-4000-8000-6d6573616c65]
label='Mesale'
palette='mesale'

[org/gnome/shell/extensions/dash-to-panel]
panel-positions='{"0":"BOTTOM","1":"BOTTOM","2":"BOTTOM","3":"BOTTOM"}'
panel-sizes='{"0":52,"1":52,"2":52,"3":52}'
panel-lengths='{"0":100,"1":100,"2":100,"3":100}'
panel-element-positions='{"0":[{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"1":[{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"2":[{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"3":[{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'
panel-element-positions-monitors-sync=true
panel-side-margins=10
panel-top-bottom-margins=8
global-border-radius=4
trans-use-custom-bg=true
trans-bg-color='#ffffff'
trans-use-custom-opacity=true
trans-panel-opacity=0.42
trans-use-border=true
trans-border-width=1
trans-border-use-custom-color=true
trans-border-custom-color='rgba(255,255,255,0.55)'
dot-position='BOTTOM'
dot-style-focused='DASHES'
dot-style-unfocused='DOTS'
dot-color-dominant=false
dot-color-override=true
dot-color-1='#2f7fe0'
dot-color-2='#2f7fe0'
dot-color-3='#2f7fe0'
dot-color-4='#2f7fe0'
dot-size=3
appicon-margin=4
appicon-padding=6
animate-appicon-hover=true
show-apps-icon-file='/usr/share/icons/hicolor/scalable/apps/mesale-flame.svg'
show-apps-icon-side-padding=10
hot-keys=true
hide-overview-on-startup=true
extension-version=9999
stockgs-keep-dash=false
click-action='CYCLE-MIN'
group-apps=true
show-tooltip=true

[org/gnome/shell/extensions/blur-my-shell]
settings-version=8
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_cloud1'>, 'params': <{'unscaled_radius': <44>, 'brightness': <1.0>}>}>]>}}

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
static-blur=true
override-background=false
corner-radius=20
unblur-in-overview=false

[org/gnome/shell/extensions/blur-my-shell/popup]
blur=true
override-background=false
preserve-shell-theme=true
menu-corner-radius=22
quick-settings-corner-radius=26
calendar-corner-radius=22
notification-corner-radius=18
dialog-corner-radius=24

[org/gnome/shell/extensions/blur-my-shell/overview]
blur=true

[org/gnome/shell/extensions/blur-my-shell/lockscreen]
blur=true

[org/gnome/shell/extensions/blur-my-shell/applications]
blur=true
enable-all=false
whitelist=['org.gnome.Ptyxis']
opacity=225
dynamic-opacity=false
corner-radius=18
