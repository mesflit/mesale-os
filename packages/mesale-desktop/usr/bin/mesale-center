#!/usr/bin/python3
"""Mesale Center: look, features, system."""
import json, locale, os, platform, re, subprocess, sys
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GdkPixbuf, Gio, GLib, Gtk

try: locale.setlocale(locale.LC_ALL, "")
except locale.Error: pass
TR = (locale.getlocale(locale.LC_MESSAGES)[0] or "en").startswith("tr")
T = lambda tr, en: tr if TR else en
VURGU = {"orange": "#e9792f", "red": "#dc3f4e", "pink": "#dd5a96", "purple": "#8b6cf0", "blue": "#3f7de0",
         "teal": "#1f9aa0", "green": "#2f9e63", "yellow": "#d39b16", "slate": "#6b7585"}
OZ = "/usr/lib/mesale/features"
CUBUK = "/org/gnome/shell/extensions/dash-to-panel/"
CSS = """
.renk { border-radius: 999px; min-width: 34px; min-height: 34px; padding: 0; }
.renk:checked { outline: 3px solid alpha(currentColor,.7); outline-offset: 3px; }
.duvar { padding: 0; border-radius: 14px; }
.duvar:checked { outline: 3px solid var(--accent-bg-color); outline-offset: 3px; }
""" + "".join(f".r-{a} {{ background: {h}; }}" for a, h in VURGU.items())
S = Gio.Settings.new

def dconf(anahtar, deger): subprocess.run(["dconf", "write", CUBUK + anahtar, deger], check=False)
def oku(anahtar, yedek): return subprocess.run(["dconf", "read", CUBUK + anahtar], capture_output=True, text=True).stdout.strip() or yedek

class Pencere(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Mesale Center", default_width=780, default_height=680)
        self.arayuz, self.zemin = S("org.gnome.desktop.interface"), S("org.gnome.desktop.background")
        self.kilit, self.kabuk = S("org.gnome.desktop.screensaver"), S("org.mesale.shell")
        yigin = Adw.ViewStack()
        for ad, baslik, simge, s in [("g", T("Görünüm", "Look"), "applications-graphics-symbolic", self.gorunum()),
                                     ("o", T("Özellikler", "Features"), "application-x-addon-symbolic", self.ozellikler()),
                                     ("s", T("Sistem", "System"), "computer-symbolic", self.sistem())]:
            yigin.add_titled_with_icon(s, ad, baslik, simge)
        ust = Adw.HeaderBar(title_widget=Adw.ViewSwitcher(stack=yigin, policy=Adw.ViewSwitcherPolicy.WIDE))
        self.tost = Adw.ToastOverlay(child=yigin)
        g = Adw.ToolbarView(content=self.tost); g.add_top_bar(ust)
        self.set_content(g)

    def gorunum(self):
        s = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title=T("Duvar kâğıdı", "Wallpaper"))
        k = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=12, row_spacing=12,
                        max_children_per_line=4, min_children_per_line=2, homogeneous=True, margin_top=6)
        grup, simdi = None, self.zemin.get_string("picture-uri")
        for ad, v in json.load(open("/usr/share/mesale/looks.json")).items():
            r = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(f"/usr/share/mesale/previews/{ad}.png", 150, 84, True)))
            r.set_content_fit(Gtk.ContentFit.COVER); r.set_size_request(150, 86); r.set_tooltip_text(v["name"])
            uri = f"file:///usr/share/backgrounds/mesale/{ad}.jpg"
            b = Gtk.ToggleButton(css_classes=["duvar", "flat"], group=grup, child=r, active=uri == simdi, overflow=Gtk.Overflow.HIDDEN)
            grup = grup or b
            b.connect("toggled", self.duvar, uri); k.append(b)
        g.add(k); s.add(g)

        g = Adw.PreferencesGroup(title=T("Renkler", "Colors"))
        modlar = ["light", "dark", "auto"]
        r = Adw.ComboRow(title=T("Tema", "Theme"), subtitle=T("Otomatik: 07–19 arası açık", "Auto: light 07–19"),
                         model=Gtk.StringList.new([T("Açık", "Light"), T("Koyu", "Dark"), T("Otomatik", "Auto")]))
        r.set_selected(modlar.index(self.kabuk.get_string("theme-mode")))
        r.connect("notify::selected", lambda x, _p: self.kabuk.set_string("theme-mode", modlar[x.get_selected()]))
        g.add(r)
        r, kutu, grup = Adw.ActionRow(title=T("Vurgu", "Accent")), Gtk.Box(spacing=10, valign=Gtk.Align.CENTER, margin_top=10, margin_bottom=10), None
        for ad in VURGU:
            b = Gtk.ToggleButton(css_classes=["renk", f"r-{ad}"], group=grup, tooltip_text=ad, active=self.arayuz.get_string("accent-color") == ad)
            grup = grup or b
            b.connect("toggled", self.vurgu, ad); kutu.append(b)
        r.add_suffix(kutu); g.add(r); s.add(g)

        g = Adw.PreferencesGroup(title=T("Alt çubuk", "Bar"))
        yuk = re.search(r'"0":\s*(\d+)', oku("panel-sizes", '{"0":52}'))
        g.add(self.olcek(T("Yükseklik", "Height"), int(yuk[1]) if yuk else 52, 36, 72, lambda v: dconf("panel-sizes", "'" + json.dumps({str(i): v for i in range(4)}) + "'")))
        g.add(self.olcek(T("Opaklık (%)", "Opacity (%)"), round(float(oku("trans-panel-opacity", "0.94")) * 100), 20, 100, lambda v: dconf("trans-panel-opacity", str(v / 100))))
        g.add(self.olcek(T("Kenar boşluğu", "Margin"), int(oku("panel-side-margins", "10")), 0, 60, lambda v: dconf("panel-side-margins", str(v))))
        r = Adw.SwitchRow(title=T("Pencere gelince gizlen", "Hide behind windows"), active=oku("intellihide", "false") == "true")
        r.connect("notify::active", lambda x, _p: (dconf("intellihide-hide-from-windows", "true"), dconf("intellihide", str(x.get_active()).lower())))
        g.add(r); s.add(g)
        return s

    def olcek(self, baslik, deger, az, cok, fn):
        r = Adw.ActionRow(title=baslik)
        c = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, az, cok, 1)
        c.set_value(deger); c.set_size_request(240, -1); c.set_draw_value(True); c.set_value_pos(Gtk.PositionType.LEFT)
        c.connect("value-changed", lambda x: fn(int(x.get_value()))); r.add_suffix(c); return r

    def duvar(self, b, uri):
        if b.get_active():
            for s, a in [(self.zemin, "picture-uri"), (self.zemin, "picture-uri-dark"), (self.kilit, "picture-uri")]: s.set_string(a, uri)

    def vurgu(self, b, ad):
        if b.get_active():
            self.arayuz.set_string("accent-color", ad)
            for i in range(1, 5): dconf(f"dot-color-{i}", f"'{VURGU[ad]}'")

    def ozellikler(self):
        s = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title=T("Özellikler", "Features"), description=T("Kurulum sonrası da istediğini ekle.", "Add what you need, any time."))
        kurulu = {l.split()[1] for l in subprocess.run(["mesale-feature", "list"], capture_output=True, text=True).stdout.splitlines() if l.startswith(" *")}
        gruplar = {}
        for ad in sorted(os.listdir(OZ)):
            m = lambda k: re.search(rf'^{k}="?([^"\n]*)', open(f"{OZ}/{ad}").read(), re.M)[1]
            gruplar.setdefault(m("GROUP"), []).append((ad, m("NAME"), m("DESC")))
        s.add(g)
        for grup, oge in gruplar.items():
            g = Adw.PreferencesGroup(title=grup.capitalize())
            for ad, baslik, ac in oge:
                r = Adw.ActionRow(title=GLib.markup_escape_text(baslik), subtitle=GLib.markup_escape_text(ac))
                b = Gtk.Button(valign=Gtk.Align.CENTER); self.dugme(b, ad in kurulu)
                b.connect("clicked", self.degistir, ad); r.add_suffix(b); g.add(r)
            s.add(g)
        return s

    def dugme(self, b, kurulu):
        b.var = kurulu
        b.set_label(T("Kaldır", "Remove") if kurulu else T("Kur", "Install"))
        b.set_css_classes([] if kurulu else ["suggested-action"]); b.set_sensitive(True)

    def degistir(self, b, ad):
        var = b.var; b.set_sensitive(False); b.set_child(Adw.Spinner())
        p = Gio.Subprocess.new(["pkexec", "/usr/bin/mesale-feature", "remove" if var else "add", ad], Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        def bitti(p, sonuc):
            try: tamam = p.wait_check_finish(sonuc)
            except GLib.Error: tamam = False
            self.dugme(b, var ^ tamam)
            self.tost.add_toast(Adw.Toast(title=f"{ad}: " + (T("tamam", "done") if tamam else T("başarısız", "failed"))))
        p.wait_check_async(None, bitti)

    def sistem(self):
        s = Adw.PreferencesPage(); g = Adw.PreferencesGroup()
        kabuk = subprocess.run(["gnome-shell", "--version"], capture_output=True, text=True).stdout.strip()
        for a, b in [("Mesale OS", platform.freedesktop_os_release().get("VERSION", "")), ("Debian", open("/etc/debian_version").read().strip()),
                     ("Kernel", platform.release()), (T("Masaüstü", "Desktop"), kabuk)]:
            g.add(Adw.ActionRow(title=a, subtitle=b, css_classes=["property"]))
        r = Adw.ActionRow(title=T("Güncellemeler", "Updates"), activatable=True); r.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        r.connect("activated", lambda _r: subprocess.Popen(["gnome-software", "--mode=updates"]) if GLib.find_program_in_path("gnome-software")
                  else subprocess.Popen(["ptyxis", "--new-window", "--", "bash", "-c", "sudo apt update && sudo apt full-upgrade; read -r"]))
        s.add(g); g = Adw.PreferencesGroup(); g.add(r); s.add(g); return s

class Uygulama(Adw.Application):
    def do_activate(self):
        css = Gtk.CssProvider(); css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, 600)
        (self.get_active_window() or Pencere(self)).present()

sys.exit(Uygulama(application_id="org.mesale.Center").run(sys.argv))
